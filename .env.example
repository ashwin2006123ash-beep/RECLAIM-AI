# RECLAIM AI - Environment Configuration Example
# Copy this file to .env and configure values as needed.
# NEVER commit real API keys or secrets to version control.

# Server Configuration
PORT=5000
FLASK_DEBUG=False
SECRET_KEY=reclaim-ai-hackathon-2026-secret-key-change-in-production

# SQLite Database Location
DATABASE_PATH=reclaim_ai.db

# Google Gemini API Key (Optional)
# If provided, enables live server-side Gemini Interaction reasoning.
# If omitted, RECLAIM AI operates seamlessly in high-fidelity deterministic fallback mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
